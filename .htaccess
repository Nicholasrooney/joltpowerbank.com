# Block private folders (stats database, PHP includes)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(data|includes)(/|$) - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm)$ - [F,L]

  # Password gate (0000) over the whole site. Remove this block to make the site public again.
  RewriteCond %{REQUEST_URI} !^/gate\.php$
  RewriteCond %{REQUEST_URI} !^/google033f461ff1ae5955\.html$
  RewriteCond %{REQUEST_URI} !^/assets/fonts/
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)jolt_gate=8a5f583463b8bda299b4cb071dc5b5bd(;|$)
  RewriteRule ^ /gate.php [L]
</IfModule>
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm)$">
  Require all denied
</FilesMatch>
# jolt-stats
# Always fetch fresh HTML (so new versions show straight away); CSS/JS/images carry ?v= versions and can be cached long
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
DirectoryIndex index.html index.php
